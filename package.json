{
  "name": "drp-cms",
  "description": "Internal DRP Build Lab tool at cms.drpbuildlab.com. Module 1: blog editor that publishes Markdown to drp_compro.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "node --test --experimental-strip-types src/lib/blog/*.test.ts src/lib/insights/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@neon/auth": "^0.8.2",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@smithy/node-http-handler": "^4.14.1",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3"
  }
}
