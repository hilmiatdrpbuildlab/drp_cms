# ---- Written by `neon env pull` (project drp-cms, branch main) ------------------------------
DATABASE_URL="postgresql://…-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://….c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_AUTH_BASE_URL="https://ep-….neonauth.c-7.eu-central-1.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="…/.well-known/jwks.json"   # unused: the app checks sessions with cookies
# Object storage. On Netlify, AWS_* is reserved: set the same values as NEON_STORAGE_* instead.
AWS_ENDPOINT_URL_S3="https://br-….storage.c-7.eu-central-1.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_…"
AWS_SECRET_ACCESS_KEY="nsk_live_…"
AWS_REGION="eu-central-1"

# ---- App-owned: add these yourself --------------------------------------------------------
# 32+ random characters; signs the session cookie cache. node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=""
# Only verified addresses on this domain get in.
ALLOWED_EMAIL_DOMAIN="drpbuildlab.com"

# Publishing: fine-grained PAT (or GitHub App token) with Contents read/write on drp_compro only.
GITHUB_TOKEN=""
GITHUB_REPO="Lathif21/drp_compro"
GITHUB_BRANCH="main"
# The website GITHUB_REPO deploys to (no trailing slash). Lets the CMS link to articles and show when a
# publish is live. Optional; without it, publish progress stops at "built".
SITE_URL=""

# Insights: a FULL-ACCESS key on the Resend team that drpbuildlab.com's blog newsletter uses
# (a sending-only key can't read contacts). Without it the Insights page explains what's missing.
RESEND_API_KEY=""

# Offers (docs/offers-consent-contract.md). Leave MARKETING_CONSENT_VERSION empty until the lawyer approves.
MAIL_FROM=""                       # the site's value: 'DRP BuildLab <…@drpbuildlab.com>'
MARKETING_CONSENT_VERSION=""       # e.g. 2026-11-v1, the same as on the site
NEWSLETTER_SECRET=""               # the same as the site's
RESEND_WEBHOOK_SECRET=""           # whsec_… of the webhook to /api/webhooks/resend
